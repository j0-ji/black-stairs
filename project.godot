; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Black Stairs"
run/main_scene="uid://c8kdtw08ido66"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Utilities/game_manager.gd"
SceneManager="*res://Utilities/scene_manager.gd"
InventoryManager="*res://Utilities/inventory_manager.gd"
UpgradeManager="*res://Utilities/upgrade_manager.gd"
WalletManager="*res://Utilities/wallet_manager.gd"
EventBus="*res://Utilities/event_bus.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://Components/": "pink",
"res://Entities/": "green",
"res://Stages/": "yellow",
"res://UI/": "orange"
}

[global_group]

player=""
enemies=""
collector="use for entities that should be able to collect objects that use the collectable component"
attractable="use for entities that should be able to get attracted by objects that use the attractor component"

